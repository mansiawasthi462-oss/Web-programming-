{
  "info": {
    "name": "Student API - CRUD",
    "description": "CRUD requests for the Express + MongoDB Student API. Run Create first; it saves studentId for the other requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "studentId", "value": "" }
  ],
  "item": [
    {
      "name": "Create Student",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 201', () => pm.response.to.have.status(201));",
        "const json = pm.response.json();",
        "pm.test('Student returned', () => pm.expect(json.data).to.have.property('_id'));",
        "pm.collectionVariables.set('studentId', json.data._id);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mansi Awasthi\",\n  \"email\": \"mansi@example.com\",\n  \"age\": 21,\n  \"course\": \"Web Programming\"\n}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "Get All Students",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Data is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
      ] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] } }
    },
    {
      "name": "Get Student By ID",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] } }
    },
    {
      "name": "Update Student",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Course updated', () => pm.expect(pm.response.json().data.course).to.eql('Full Stack Development'));"
      ] } }],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] },
        "body": { "mode": "raw", "raw": "{\n  \"course\": \"Full Stack Development\",\n  \"age\": 22\n}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "Delete Student",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] } }
    }
  ]
}
